{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*terraform.tfstate*": "deny",
      "~/.aws/*": "deny",
      "~/.ssh/*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "deny",
    "bash": {
      "*": "deny",
      "ls": "allow",
      "ls -la": "allow",
      "git status": "allow",
      "git status --short": "allow",
      "git diff": "allow",
      "git diff --stat": "allow",
      "git diff --cached": "allow",
      "git diff --check": "allow",
      "git log --oneline -20": "allow",
      "python3 -m unittest discover -s tests": "allow",
      "git * --output*": "deny",
      "git branch *": "deny",
      "git push*": "deny",
      "* > *": "deny",
      "* >> *": "deny",
      "* | *": "deny"
    },
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  }
}
