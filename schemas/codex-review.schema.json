{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ktg6/ai-cross-pr-review/schemas/codex-review.schema.json",
  "title": "AI cross-review verification result (model output)",
  "description": "Codexが返す構造化された再検証結果。OpenAI Responses APIのstrict structured outputとして送るため、すべてのobjectはadditionalProperties=falseで、全propertyをrequiredに列挙する。省略可能な値はnullで表現する。repository、PR番号、SHA、投稿先はモデルに決定させないため本schemaには含めない。これらはtrusted wrapperが付与する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "claim_reviews", "additional_findings", "insufficient_context", "limitations"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1"]
    },
    "summary": {
      "type": "string",
      "description": "一次レビューをどう検証したかの要約。"
    },
    "claim_reviews": {
      "type": "array",
      "description": "一次レビューのfindingsと同じ件数・同じ順序で1件ずつ返す検証結果。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claude_index", "status", "severity", "confidence", "rationale", "suggested_fix", "duplicate_of"],
        "properties": {
          "claude_index": {
            "type": "integer",
            "description": "一次レビューfindings配列の0始まりの添字。"
          },
          "status": {
            "type": "string",
            "enum": ["adopted", "duplicate", "rejected", "deferred"]
          },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "rationale": {
            "type": "string",
            "description": "diff上の根拠。rejectedでは否定の根拠、deferredでは何が分かれば判断できるかを書く。"
          },
          "suggested_fix": {
            "type": ["string", "null"],
            "description": "修正案。示せない場合はnull。"
          },
          "duplicate_of": {
            "type": ["integer", "null"],
            "description": "statusがduplicateのとき、先に現れた同一原因のclaude_index。それ以外はnull。"
          }
        }
      }
    },
    "additional_findings": {
      "type": "array",
      "description": "一次レビューが報告していない追加指摘。最大20件。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail", "severity", "confidence", "category", "path", "line", "suggested_fix"],
        "properties": {
          "title": {"type": "string"},
          "detail": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "category": {
            "type": "string",
            "enum": ["correctness", "security", "reliability", "maintainability", "testing", "other"]
          },
          "path": {"type": "string"},
          "line": {"type": ["integer", "null"]},
          "suggested_fix": {"type": ["string", "null"]}
        }
      }
    },
    "insufficient_context": {
      "type": "array",
      "description": "判断に必要だったがbundleに無かった情報。",
      "items": {"type": "string"}
    },
    "limitations": {
      "type": "array",
      "description": "bundleの制約により確認できなかった点。",
      "items": {"type": "string"}
    }
  }
}
